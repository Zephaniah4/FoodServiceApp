# Active location for this deployment
# Allowed: planoDallas, garland, rowlett
REACT_APP_LOCATION=planoDallas

# Garland Firebase config (required only when REACT_APP_LOCATION=garland)
REACT_APP_FIREBASE_GARLAND_API_KEY=
REACT_APP_FIREBASE_GARLAND_AUTH_DOMAIN=
REACT_APP_FIREBASE_GARLAND_PROJECT_ID=
REACT_APP_FIREBASE_GARLAND_STORAGE_BUCKET=
REACT_APP_FIREBASE_GARLAND_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_GARLAND_APP_ID=

# Rowlett Firebase config (required only when REACT_APP_LOCATION=rowlett)
REACT_APP_FIREBASE_ROWLETT_API_KEY=
REACT_APP_FIREBASE_ROWLETT_AUTH_DOMAIN=
REACT_APP_FIREBASE_ROWLETT_PROJECT_ID=
REACT_APP_FIREBASE_ROWLETT_STORAGE_BUCKET=
REACT_APP_FIREBASE_ROWLETT_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_ROWLETT_APP_ID=
